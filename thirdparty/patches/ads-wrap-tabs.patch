+//============================================================================
+int CDockAreaTabBar::heightForWidth(int Width) const
+{
+	if (!tabsWrapping())
+	{
+		return Super::heightForWidth(Width);
+	}
+	// Let rows grow naturally, but keep at least half the area for the editor.
+	const int Frame = 2 * frameWidth();
+	const int Limit = qMax(d->TabsLayout->minimumSize().height() + Frame, d->DockArea->height() / 2);
+	int ContentWidth = qMax(1, Width - Frame);
+	int Height = d->TabsLayout->heightForWidth(ContentWidth) + Frame;
+	if (Height > Limit)
+	{
+		ContentWidth = qMax(1, ContentWidth - verticalScrollBar()->sizeHint().width());
+		Height = d->TabsLayout->heightForWidth(ContentWidth) + Frame;
+	}
+	return qMin(Height, Limit);
+}
