+//============================================================================
+void CDockAreaTabBar::setTabsWrapping(bool Enabled)
+{
+	if (Enabled == tabsWrapping())
+	{
+		return;
+	}
+	if (Enabled)
+	{
+		d->UnwrappedMinimumHeight = minimumHeight();
+		d->UnwrappedMaximumHeight = maximumHeight();
+	}
+	else
+	{
+		setMinimumHeight(d->UnwrappedMinimumHeight);
+		setMaximumHeight(d->UnwrappedMaximumHeight);
+	}
+	d->TabsLayout->setWrapping(Enabled);
+	auto Policy = sizePolicy();
+	Policy.setHorizontalPolicy(Enabled ? QSizePolicy::Expanding : QSizePolicy::Maximum);
+	Policy.setHeightForWidth(Enabled);
+	setSizePolicy(Policy);
+	// The title bar has an expanding spacer. Give wrapped tabs the available
+	// width instead of splitting it between the tab bar and that spacer.
+	if (parentWidget() == d->DockArea->titleBar())
+	{
+		if (auto Layout = qobject_cast<QBoxLayout*>(parentWidget()->layout()))
+		{
+			Layout->setStretch(Layout->indexOf(this), Enabled ? 1 : 0);
+		}
+	}
+	setVerticalScrollBarPolicy(Enabled ? Qt::ScrollBarAsNeeded : Qt::ScrollBarAlwaysOff);
+	horizontalScrollBar()->setValue(0);
+	verticalScrollBar()->setValue(0);
+	d->updateTabs();
+	updateGeometry();
+	d->LastWrappingSizeHint = QSize();
+	updateWrappingGeometry();
+}
+
+//============================================================================
+bool CDockAreaTabBar::tabsWrapping() const
+{
+	return d->TabsLayout && d->TabsLayout->isWrapping();
+}
+
+//============================================================================
+void CDockAreaTabBar::updateWrappingGeometry()
+{
+	if (!tabsWrapping() || d->GeometryUpdatePending)
+	{
+		return;
+	}
+	d->GeometryUpdatePending = true;
+	QTimer::singleShot(0, this, [this] {
+		if (!tabsWrapping())
+		{
+			d->GeometryUpdatePending = false;
+			return;
+		}
+		// Refresh scroll ranges even if the viewport stays the same size (for
+		// example, a renamed title adds a row while the bar is height-limited).
+		setWidgetResizable(true);
+		const auto Hint = sizeHint();
+		// ADS gives the surrounding title bar a Fixed vertical size policy.
+		// Synchronize its child's actual height as rows grow or shrink; a
+		// width-dependent sizeHint alone can leave the parent's old HFW cached.
+		if (minimumHeight() != Hint.height() || maximumHeight() != Hint.height())
+		{
+			setFixedHeight(Hint.height());
+			// Also invalidate the title bar's item in the outer dock layout.
+			d->DockArea->titleBar()->updateGeometry();
+		}
+		if (Hint != d->LastWrappingSizeHint)
+		{
+			d->LastWrappingSizeHint = Hint;
+			updateGeometry();
+		}
+		if (auto Tab = currentTab())
+		{
+			ensureWidgetVisible(Tab, 0, 0);
+		}
+		d->GeometryUpdatePending = false;
+	});
+}
+
+//============================================================================
+bool CDockAreaTabBar::viewportEvent(QEvent* Event)
+{
+	const bool Result = Super::viewportEvent(Event);
+	if (Event->type() == QEvent::Resize)
+	{
+		updateWrappingGeometry();
+	}
+	return Result;
 }
 
